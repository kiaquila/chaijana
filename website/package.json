{
  "name": "chaijana-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "undici": "7.29.1",
    "sharp": "0.35.5",
    "image-size": "$image-size"
  },
  "scripts": {
    "dev": "npm run sync:menu && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "sync:menu": "npm --prefix ../menu run build && node scripts/sync-menu.mjs && node scripts/write-headers.mjs",
    "build": "npm run sync:menu && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "stage:deploy": "WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy",
    "stage:preview": "WRANGLER_WRITE_LOGS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler versions upload",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "image-size": "file:vendor/image-size",
    "react-server-dom-webpack": "19.3.0",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.3.4",
    "wrangler": "4.147.0"
  },
  "type": "module"
}
